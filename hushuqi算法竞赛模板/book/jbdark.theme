    "Float":          {"text-color": "#2aacb8", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Constant":       {"text-color": "#c77dbb", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Char":           {"text-color": "#6aab73", "background-color": null, "bold": false, "italic": false, "underline": false},
    "SpecialChar":    {"text-color": "#cc7832", "background-color": null, "bold": false, "italic": false, "underline": false},
    "String":         {"text-color": "#6aab73", "background-color": null, "bold": false, "italic": false, "underline": false},
    "VerbatimString": {"text-color": "#6aab73", "background-color": null, "bold": false, "italic": false, "underline": false},
    "SpecialString":  {"text-color": "#6aab73", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Import":         {"text-color": "#cc7832", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Comment":        {"text-color": "#7a7e85", "background-color": null, "bold": false, "italic": true,  "underline": false},
    "Documentation":  {"text-color": "#5f826b", "background-color": null, "bold": false, "italic": true,  "underline": false},
    "Annotation":     {"text-color": "#b3ae60", "background-color": null, "bold": false, "italic": false, "underline": false},
    "CommentVar":     {"text-color": "#7a7e85", "background-color": null, "bold": false, "italic": true,  "underline": false},
