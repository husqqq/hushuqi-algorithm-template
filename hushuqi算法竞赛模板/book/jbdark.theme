    "ControlFlow":    {"text-color": "#cc7832", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Operator":       {"text-color": "#bcbec4", "background-color": null, "bold": false, "italic": false, "underline": false},
    "BuiltIn":        {"text-color": "#bcbec4", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Extension":      {"text-color": "#bcbec4", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Preprocessor":   {"text-color": "#cc7832", "background-color": null, "bold": false, "italic": false, "underline": false},
