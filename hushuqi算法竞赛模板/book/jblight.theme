{
  "text-color": "#080808",
  "background-color": "#f6f7f9",
  "line-number-color": "#9aa0a8",
  "line-number-background-color": "#f6f7f9",
  "text-styles": {
    "Normal":         {"text-color": "#080808", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Keyword":        {"text-color": "#0033b3", "background-color": null, "bold": false, "italic": false, "underline": false},
    "ControlFlow":    {"text-color": "#0033b3", "background-color": null, "bold": false, "italic": false, "underline": false},
    "DataType":       {"text-color": "#0033b3", "background-color": null, "bold": false, "italic": false, "underline": false},
    "DecVal":         {"text-color": "#1750eb", "background-color": null, "bold": false, "italic": false, "underline": false},
    "BaseN":          {"text-color": "#1750eb", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Float":          {"text-color": "#1750eb", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Constant":       {"text-color": "#871094", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Char":           {"text-color": "#067d17", "background-color": null, "bold": false, "italic": false, "underline": false},
    "SpecialChar":    {"text-color": "#0033b3", "background-color": null, "bold": false, "italic": false, "underline": false},
    "String":         {"text-color": "#067d17", "background-color": null, "bold": false, "italic": false, "underline": false},
    "VerbatimString": {"text-color": "#067d17", "background-color": null, "bold": false, "italic": false, "underline": false},
    "SpecialString":  {"text-color": "#067d17", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Import":         {"text-color": "#067d17", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Comment":        {"text-color": "#8c8c8c", "background-color": null, "bold": false, "italic": true,  "underline": false},
    "Documentation":  {"text-color": "#8c8c8c", "background-color": null, "bold": false, "italic": true,  "underline": false},
    "Annotation":     {"text-color": "#9e880d", "background-color": null, "bold": false, "italic": false, "underline": false},
    "CommentVar":     {"text-color": "#8c8c8c", "background-color": null, "bold": false, "italic": true,  "underline": false},
    "Other":          {"text-color": "#080808", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Function":       {"text-color": "#00627a", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Variable":       {"text-color": "#080808", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Operator":       {"text-color": "#080808", "background-color": null, "bold": false, "italic": false, "underline": false},
    "BuiltIn":        {"text-color": "#080808", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Extension":      {"text-color": "#080808", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Preprocessor":   {"text-color": "#0033b3", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Attribute":      {"text-color": "#9e880d", "background-color": null, "bold": false, "italic": false, "underline": false},
    "RegionMarker":   {"text-color": "#080808", "background-color": "#dbe6ff", "bold": false, "italic": false, "underline": false},
    "Information":    {"text-color": "#9e880d", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Warning":        {"text-color": "#c1121f", "background-color": null, "bold": false, "italic": false, "underline": false},
    "Alert":          {"text-color": "#c1121f", "background-color": null, "bold": true,  "italic": false, "underline": false},
    "Error":          {"text-color": "#c1121f", "background-color": null, "bold": false, "italic": false, "underline": true}
  }
}
